{
  "schemaVersion": 1,
  "description": "Offline golden-output corpus for the Nixio agent harness and box translation routing. Every provider response is simulated; no API key and no network request are used.",
  "testRates": {
    "label": "Synthetic fixture test rates used only to exercise CI cost accounting; they are not provider prices and must not be read as current or quoted pricing.",
    "inputPerMillionTokensUsd": 0.1,
    "outputPerMillionTokensUsd": 0.4
  },
  "cases": [
    {
      "id": "openai-boxes-glossary-golden",
      "note": "OpenAI-compatible box translation. The simulated reply wraps fenced JSON in a think block, so the real extractJsonObject cleanup path must run before the golden comparison.",
      "kind": "translate",
      "provider": "openai",
      "sourceLanguage": "Japanese",
      "targetLanguage": "Vietnamese",
      "direction": "rtl",
      "notes": "Trang bìa chương 1.",
      "glossary": "# Nhân vật\n五条悟 = Gojo Satoru\n呪術師 = Chú thuật sư\n",
      "page": { "name": "01.png", "width": 800, "height": 1200 },
      "boxes": [
        { "id": "b1", "text": "五条悟は最強だ。" },
        { "id": "b2", "text": "呪術師として戦え。" }
      ],
      "script": [
        {
          "note": "Fenced JSON with a reasoning prefix; production strips both without touching the lines.",
          "reply": {
            "choices": [
              {
                "message": {
                  "role": "assistant",
                  "content": "<think>Đối chiếu glossary trước khi trả.</think>\n```json\n{\"lines\":[{\"id\":\"B1\",\"text\":\"Gojo Satoru là kẻ mạnh nhất.\"},{\"id\":\"B2\",\"text\":\"Hãy chiến đấu với tư cách một Chú thuật sư.\"}]}\n```"
                }
              }
            ],
            "usage": { "prompt_tokens": 1460, "completion_tokens": 92, "total_tokens": 1552 }
          }
        }
      ],
      "expected": {
        "steps": 1,
        "translations": {
          "b1": "Gojo Satoru là kẻ mạnh nhất.",
          "b2": "Hãy chiến đấu với tư cách một Chú thuật sư."
        }
      },
      "gates": {
        "maxSteps": 1,
        "minIdCoverage": 1,
        "minGlossaryCompliance": 1,
        "minReferenceMatches": 1,
        "maxUntranslatedSource": 0,
        "minToolPrecision": 1,
        "minToolRecall": 1
      }
    },
